@echo off
setlocal
rem Dashboard launcher template.
rem Args:
rem   1) project_root (optional): target project root. Defaults to current working directory.
rem Behavior:
rem   - No args: run against current working directory.
rem Env:
rem   - PYTHON_EXE (optional): Python executable path. Default is "python".

if "%~1"=="" (
  set "PROJECT_ROOT=%CD%"
) else (
  set "PROJECT_ROOT=%~1"
)

set "PYTHON_EXE=python"
set "SCRIPT_DIR=%~dp0"

for %%I in ("%SCRIPT_DIR%..\..") do set "PYTOOL_REPO=%%~fI"

if not exist "%PROJECT_ROOT%" (
  echo Project root not found: %PROJECT_ROOT%
  exit /b 3
)

pushd "%PROJECT_ROOT%"
%PYTHON_EXE% "%PYTOOL_REPO%\dashboard\src\ptd_dashboard\app\main.py" --project-root "%PROJECT_ROOT%"
set "EXIT_CODE=%ERRORLEVEL%"
popd

exit /b %EXIT_CODE%
